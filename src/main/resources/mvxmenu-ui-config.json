{
  "version": 3,
  "layout": {
    "screenWidth": 1280,
    "screenHeight": 800,
    "sidebarWidth": 260,
    "headerHeight": 48,
    "footerHeight": 32,
    "padding": 16,
    "slotSize": 200,
    "slotSpacing": 8
  },
  "theme": {
    "accent": "DEFAULT (PURPLE)",
    "customAccent": "#8B5CF6",
    "bgOpacity": 90,
    "panelRounding": 12,
    "animationSpeed": 100,
    "highContrast": false,
    "blurEffects": true,
    "scanlineOverlay": false
  },
  "categories": [
    { "id": "COMBAT", "label": "COMBAT", "icon": "CROSSHAIR" },
    { "id": "MOVEMENT", "label": "MOVEMENT", "icon": "ZAP" },
    { "id": "PLAYER", "label": "PLAYER", "icon": "EYE" },
    { "id": "RENDER", "label": "RENDER", "icon": "LAYERS" },
    { "id": "WORLD", "label": "WORLD", "icon": "MAP" },
    { "id": "EXPLOIT", "label": "EXPLOIT", "icon": "SHIELD" },
    { "id": "MISC", "label": "MISC", "icon": "SLIDERS" }
  ],
  "components": {
    "button": { "radius": 8, "height": 32 },
    "toggle": { "width": 40, "height": 24 },
    "slider": { "trackHeight": 6, "thumbSize": 16 },
    "dropdown": { "height": 28 },
    "checkbox": { "size": 16 },
    "keybind": { "minWidth": 80, "height": 28 }
  },
  "typography": {
    "font": "JetBrains Mono",
    "sizes": { "hero": 28, "display": 20, "heading": 16, "subheading": 13, "default": 12, "body": 11, "label": 10, "micro": 9 }
  }
}